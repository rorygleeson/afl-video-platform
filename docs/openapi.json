  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Developer API Gateway usage-plan key; not end-user authentication."
      }
    },
    "schemas": {
      "Scenario": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sceneCount": {
            "type": "integer"
          },
          "imageGenerationEnabled": {
            "type": "boolean"
          },
          "parallelScenes": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "UploadRequest": {
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ]
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10485760
          }
        },
        "required": [
          "contentType",
          "sizeBytes"
        ],
        "additionalProperties": false
      },
      "UploadResponse": {
        "type": "object",
        "properties": {
          "uploadKey": {
            "type": "string"
          },
          "upload": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "url",
              "fields"
            ],
            "additionalProperties": false
          },
          "expiresInSeconds": {
            "type": "integer",
            "example": 300
          }
        },
        "required": [
          "uploadKey",
          "upload"
        ],
        "additionalProperties": false
      },
      "CreateJobRequest": {
        "type": "object",
        "properties": {
          "uploadKey": {
            "type": "string",
            "pattern": "^uploads/"
          },
          "scenarioId": {
            "type": "string",
            "example": "afl-grand-final-winning-kick"
          },
          "team": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "personalMessage": {
            "type": "string"
          },
          "confirmPaidSequence": {
            "type": "boolean",
            "description": "Generation consent, not payment verification."
          }
        },
        "required": [
          "uploadKey",
          "scenarioId",
          "team",
          "firstName",
          "lastName"
        ],
        "additionalProperties": false
      },
      "Job": {
        "type": "object",
        "description": "Job projection; additional status and scene fields evolve with processing.",
        "properties": {
          "jobId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "status": {
            "type": "string",
            "description": "Legacy image-job status, not entire video pipeline."
          },
          "scenes": {
            "type": "object",
            "additionalProperties": true
          },
          "progress": {
            "$ref": "#/components/schemas/Progress"
          }
        },
        "additionalProperties": true
      },
      "Progress": {
        "type": "object",
        "properties": {
          "currentStage": {
            "type": "string",
            "enum": [
              "IMAGES",
              "VIDEO_1",
              "VIDEO_2",
              "VIDEO_3",
              "STITCHING",
              "COMPLETED"
            ]
          },
          "stageStatus": {
            "type": "string"
          },
          "terminal": {
            "type": "boolean"
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ]
          },
          "imagesCompleted": {
            "type": "integer"
          },
          "imagesTotal": {
            "type": "integer"
          },
          "videosCompleted": {
            "type": "integer"
          },
          "videosTotal": {
            "type": "integer"
          },
          "finalVideoReady": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "SignedSelfie": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "expiresInSeconds": {
            "type": "integer",
            "example": 300
          }
        },
        "required": [
          "jobId",
          "url"
        ],
        "additionalProperties": false
      },
      "ImageStatus": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "scenes": {
            "type": "object",
            "additionalProperties": true
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sceneId": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      },
      "VideoScene": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "mock": {
            "type": "boolean"
          },
          "attemptNumber": {
            "type": "integer"
          },
          "maxAttempts": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      },
      "Assembly": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "ready": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "downloadUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": true
      },
      "VideoStatus": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "videoGenerationMode": {
            "type": "string"
          },
          "realVideoMode": {
            "type": "string"
          },
          "scene1PaidApproved": {
            "type": "boolean"
          },
          "sequence": {
            "type": "object",
            "additionalProperties": true
          },
          "paidScenes": {
            "type": "object",
            "additionalProperties": true
          },
          "videos": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/VideoScene"
            }
          },
          "assembly": {
            "$ref": "#/components/schemas/Assembly"
          },
          "progress": {
            "$ref": "#/components/schemas/Progress"
          }
        },
        "additionalProperties": true
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "responses": {
      "Error400": {
        "description": "Invalid input",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error404": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error409": {
        "description": "Conflict or unsafe retry",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error500": {
        "description": "Unexpected server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error503": {
        "description": "Unavailable dependency or uncertain handoff",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
