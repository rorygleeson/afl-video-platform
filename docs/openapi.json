{
  "openapi": "3.1.0",
  "info": {
    "title": "AFL Video Platform API",
    "version": "2026-11-26-source",
    "description": "Source-derived contract for the development REST API. Verified against src/api/handler.py, infrastructure/app/backend.yaml and docs/API_ENDPOINTS.md; NOT an export or validation of the live deployed stage. 20 application method/path operations. All operations use API Gateway x-api-key; OPTIONS is a separate CORS mock. No Stripe, customer authentication or entitlement APIs currently exist. Signed S3 URLs expire in 300 seconds; do not publish real keys or returned signed URLs."
  },
  "servers": [
    {
      "url": "https://{apiId}.execute-api.ap-southeast-2.amazonaws.com/dev",
      "variables": {
        "apiId": {
          "default": "YOUR_API_ID",
          "description": "Resolve from your deployed API Gateway stack; placeholder is not a live address."
        }
      }
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
