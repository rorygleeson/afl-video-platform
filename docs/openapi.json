        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobId": {
                      "type": "string"
                    },
                    "video": {
                      "$ref": "#/components/schemas/VideoScene"
                    }
                  },
                  "required": [
                    "jobId",
                    "video"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
